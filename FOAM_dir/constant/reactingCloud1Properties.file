FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      reactingCloudProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solution
{
    active          true;
    transient       true;
    calcFrequency   1;
    maxCo           0.5;
    cellValueSourceCorrection true;

    interpolationSchemes
    {
        rho             cell;
        U               cellPoint;
        mu              cell;
        T               cellPoint;
        Cp              cell;
    }

    integrationSchemes
    {
        U               Euler;
        T               Analytical;
        m               Analytical;
    }
}

constantProperties
{
    rho0            1141;     // LOX Density @ 95K
    mu0             1.9e-4;   // LOX Viscosity
    Cp0             1680;     // LOX Heat Capacity
    T0              95;       // Injection Temp
    P_ref           40e5;     // Chamber Pressure
    V0              0.001;    // Volume (internal ref)
    Hf              0;        // Heat of formation for O2
}

subModels
{
    injectionModels
    {
        model1
        {
            type            patchInjection;
            patch           lox_inlet;
            duration        10.0;            // Continuous injection
            parcelsPerSecond 100000;         // High parcel count for stability
            massFlowRate    constant 1.2;    // Adjust based on your thrust req.
            U               uniform (0 0 20);
            T               uniform 95;
            
            sizeDistribution
            {
                type        fixedValue;
                value       100e-6;          // 100 micron initial drop size
            }
        }
    }

    dispersionModel     stochasticDispersion; // Turbulence interaction

    patchInteractionModel standardWallInteraction;

    standardWallInteractionCoeffs
    {
        type            rebound;
    }

    heatTransferModel   RanzMarshall;

    compositionModel    singleComponentMixture;

    singleComponentMixtureCoeffs
    {
        liquidComponents ( O2 );
        gasComponents    ( O2 );
    }

    phaseChangeModel    liquidEvaporation;

    liquidEvaporationCoeffs
    {
        enthalpyModel   latentHeat;
        relaxation      1.0;
        boilingTemperature 150;  // Saturation temp @ 40 bar
        latentHeat      213000;
    }

    breakupModel        KHRT;

    KHRTCoeffs
    {
        B0              0.61;
        B1              40;
        tau             1;
        cascading       false;
        CRT             0.1;
        msLimit         0.2;
        WeberLimit      12;
    }

    momentumTransferModel drag;

    dragModel           Sphere;

    surfaceTensionModel constant;

    constantSurfaceTensionCoeffs
    {
        sigma           0.013; // Surface tension LOX/O2
    }
}

cloudFunctions {}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

