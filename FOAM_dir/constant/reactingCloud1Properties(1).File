injectionModel patchInjection;

patchInjectionCoeffs
{
    patch              LOX_centerHole;   // central pintle hole patch
    parcelsPerSecond   2e6;
    massFlowRate       constant 0.12;    // LOX Mdot [kg/s]
    U                  uniform (0 0 60); // initial LOX jet velocity
    T                  uniform 90;       // LOX temperature
    sizeDistribution
    {
        type           fixedValue;
        value          50e-6;            // droplet size (50 µm)
    }
}
