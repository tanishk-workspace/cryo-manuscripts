FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heRhoThermo;    // Enthalpy-based, solves for density
    mixture         reactingMixture;
    transport       sutherland;     // Sutherland's law for viscosity
    thermo          janaf;          // NASA 7-coefficient polynomials for Cp
    equationOfState PengRobinson;   // Crucial for real-gas effects at 40 bar
    specie          specie;
    energy          sensibleEnthalpy;
}

species
(
    H2
    O2
    H2O
);

// Excess fuel is usually treated as the inert carrier in GH2/LOX engines
inertSpecie H2;

H2
{
    specie
    {
        molWeight       2.01588;
    }
    thermo
    {
        // NASA7 Coefficients: 200K-1000K / 1000K-5000K
        Tlow            200;
        Thigh           5000;
        Tcommon         1000;
        highCpCoeffs    ( 3.3375 0.000799 -2.1944e-07 2.9281e-11 -1.4749e-15 -1048.91 -4.33 );
        lowCpCoeffs     ( 2.34433 0.00798 -1.9478e-05 2.0157e-08 -7.3761e-12 -917.935 0.683 );
    }
    transport
    {
        As              1.458e-06;
        Ts              110.4;
    }
}

O2
{
    specie
    {
        molWeight       31.9988;
    }
    thermo
    {
        Tlow            200;
        Thigh           5000;
        Tcommon         1000;
        highCpCoeffs    ( 3.2825 0.00148 -5.623e-07 9.85e-11 -6.66e-15 -1061.1 5.45 );
        lowCpCoeffs     ( 3.7509 0.000561 -3.8805e-07 1.165e-10 -1.242e-14 -1063.2 3.66 );
    }
    transport
    {
        As              1.701e-06;
        Ts              127.3;
    }
}

H2O
{
    specie
    {
        molWeight       18.0153;
    }
    thermo
    {
        Tlow            200;
        Thigh           5000;
        Tcommon         1000;
        highCpCoeffs    ( 2.677 0.00297 -7.73e-07 9.44e-11 -4.26e-15 -29885.8 6.88 );
        lowCpCoeffs     ( 3.3868 0.00347 -6.354e-06 6.968e-09 -2.506e-12 -30208.1 2.59 );
    }
    transport
    {
        As              1.67e-06;
        Ts              170.4;
    }
}

// Global Diffusion and Heat Transfer parameters
// These control how the 3570K heat diffuses through the species
Pr              0.7;    // Laminar Prandtl number
Prt             0.9;    // Turbulent Prandtl number (standard for rocket engines)
Sc              0.7;    // Laminar Schmidt number
Sct             0.7;    // Turbulent Schmidt number

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
