/*--------------------------------*- C++ -*----------------------------------*/

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 4000000;   // chamber static pressure

boundaryField
{
    H2_annulus
    {
        type            totalPressure;
        p0              uniform 5400000;  //P_inj GH2
        gamma           1.4;
        value           uniform 0;
    }

    LOX_centerHole
    {
        type            zeroGradient;
    }

    outlet
    {
        type            waveTransmissive;
        field           p;
        gamma           1.2;   //gamma CEA 1.2
        lInf            0.5;
        value           uniform 0;
    }

    walls
    {
        type            zeroGradient;
    }
} //OK


