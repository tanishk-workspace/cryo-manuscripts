dimensions      [0 0 0 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    H2_annulus
    {
        type fixedValue;
        value uniform 0.0;
    }

    LOX_centerHole
    {
        type zeroGradient;  // droplets supply O2 vapor
    }

    outlet
    {
        type zeroGradient;
    }

    walls
    {
        type zeroGradient;
    }
}
