FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      decomposeParDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Total subdomains must equal n_x * n_y * n_z
numberOfSubdomains 8;

method          simple;

simpleCoeffs
{
    // How the domain is split in (x y z)
    // Example: 3 segments in X, 2 in Y, 2 in Z = 12 total
    n           (4 2 1);
    
    // delta is the 'skew' factor for the decomposition (usually 0.001)
    delta       0.001;
}

