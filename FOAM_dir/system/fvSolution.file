solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-6;
        relTol          0.1;
        smoother        DIC;
        nPreSweeps      0;
        nPostSweeps     2;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    T
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
        relTol          0.1;
    }

    k
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
    }

    omega
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-6;
    }

    Y*
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
    }
}

PISO
{
    nCorrectors     3;
    nNonOrthogonalCorrectors 0;
    residualControl
    {
        p           1e-6;
        U           1e-6;
    }
}

chemistry
{
    solver          ode;
    odeSolver       stiffChemistry;
    absTol          1e-12;
    relTol          1e-6;
}
